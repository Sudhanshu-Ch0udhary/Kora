{
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:args}) {",
      "  $0",
      "}"
    ],
    "description": "Create a function"
  },

  "If Statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "  $0",
      "}"
    ],
    "description": "If block"
  },

  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "  $0",
      "}"
    ],
    "description": "While loop"
  },

  "Print": {
    "prefix": "print",
    "body": [
      "print(${1:value})"
    ],
    "description": "Print value"
  }
}
